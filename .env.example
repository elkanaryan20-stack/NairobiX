# ── Tracking & verification (all optional; each integration stays off until set) ──
# Never commit real secrets. NEXT_PUBLIC_ values are visible in the browser by design.

# GA4 measurement ID. Defaults to the live property G-N6Y84V1D2Z if unset.
NEXT_PUBLIC_GA4_ID=

# Google Tag Manager container (GTM-XXXXXXX). If used, do NOT add a GA4
# configuration tag inside the container — GA4 is already loaded directly.
NEXT_PUBLIC_GTM_ID=

# Google Ads tag (AW-XXXXXXXXX) and a conversion label for each key action
# (Google Ads › Goals › Conversions › Tag setup › "send_to" value after the slash).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_ASSESSMENT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CONTACT=

# Meta Pixel ID (Events Manager › Data sources).
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API — server only. Generate in Events Manager › Settings.
META_CAPI_ACCESS_TOKEN=
# Optional: route server events to Events Manager › Test events while verifying.
META_CAPI_TEST_EVENT_CODE=
# Optional: Graph API version (default v25.0).
META_GRAPH_API_VERSION=

# Zoho Bookings custom field (exact label) that receives first/last-touch
# attribution for booked consultations. Create it first as a multi-line text
# field on the consultation service — Zoho rejects unknown fields.
ZOHO_BOOKINGS_ATTRIBUTION_FIELD=

# Search Console "HTML tag" verification — the content="…" value only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Meta Business Manager domain verification — the content="…" value only.
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=
